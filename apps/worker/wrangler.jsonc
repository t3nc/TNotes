{
  // 通用配置：所有真实标识均为占位符，克隆后请按需替换。
  // 1) database_id：执行 `npx wrangler d1 create tnotes`，把返回的 id 填入下方。
  // 2) 自定义域名：在下方 routes 中加入
  //      { "pattern": "notes.example.com", "custom_domain": true }
  //    并把该域名托管到同一个 Cloudflare 账号。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tnotes",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-05",
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tnotes",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}
